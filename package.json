{
  "name": "@homebackend/ts-common",
  "version": "0.0.1",
  "description": "Common code",
  "homepage": "https://github.com/homebackend/ts-common#readme",
  "bugs": {
    "url": "https://github.com/homebackend/ts-common/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebackend/ts-common.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "tsup src/index.ts --format cjs,esm",
    "build:dts": "tsc --emitDeclarationOnly --declaration",
    "build": "npm run build:js && npm run build:dts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@girs/glib-2.0": "^4.1.0",
    "@girs/soup-3.0": "^4.1.0",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "dependencies": {
    "semver": "^7.8.5"
  }
}
